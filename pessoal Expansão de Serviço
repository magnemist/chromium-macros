// ============================================================
// EXPANSÃO SERVIÇOS - CENTRAL DE SERVIÇOS UFV
// CONFIGURAÇÃO + AUTOMAÇÃO EM UM ÚNICO ARQUIVO
// ============================================================


// ============================================================
// CONFIGURAÇÃO
// ============================================================
//
// Altere somente os valores abaixo.
// O restante do código não precisa ser modificado.
// ============================================================

const CAMPUS = '1';

const PERFIL = '11230';


// ============================================================
// 1. ABRIR A SOLICITAÇÃO
// ============================================================

uiv.goto(
    'https://central-servicos.ufv.br/solicitacoes/criar?campus='
    + CAMPUS
);

uiv.log(
    'PÁGINA INICIAL ABERTA',
    'green'
);


// ============================================================
// 2. AGUARDAR O PERFIL
// ============================================================

uiv.$(
    'xpath=//*[normalize-space(text())="' +
    PERFIL +
    '"]'
);

uiv.log(
    'PERFIL ' + PERFIL + ' ENCONTRADO',
    'green'
);


// ============================================================
// 3. SELECIONAR O PERFIL
// ============================================================

uiv.page.click(
    'xpath=//*[normalize-space(text())="' +
    PERFIL +
    '"]'
);

uiv.log(
    'PERFIL ' + PERFIL + ' SELECIONADO',
    'green'
);


// ============================================================
// 4. AGUARDAR O CATÁLOGO DE SERVIÇOS
// ============================================================

uiv.$(
    'xpath=//a[contains(normalize-space(.),"Ver Catálogo de Serviços")]'
);

uiv.log(
    'CATÁLOGO ENCONTRADO',
    'green'
);


// ============================================================
// 5. ABRIR O CATÁLOGO
// ============================================================

uiv.page.click(
    'linkText=Ver Catálogo de Serviços...'
);

uiv.log(
    'CATÁLOGO OK',
    'green'
);


// ============================================================
// 6. EXPANDIR TODOS OS CATÁLOGOS
// ============================================================

const quantidade = uiv.evaluate(`
    const paineis = document.querySelectorAll(
        '#conteudo .panel-body.collapse[id^="catalogo_"]'
    );

    paineis.forEach(painel => {
        painel.classList.add('in');
        painel.setAttribute('aria-expanded', 'true');
        painel.style.height = '';
    });

    const botoes = document.querySelectorAll(
        '#conteudo .panel-heading[data-toggle="collapse"][data-target^="#catalogo_"]'
    );

    botoes.forEach(botao => {
        botao.setAttribute('aria-expanded', 'true');
    });

    return paineis.length;
`);

uiv.log(
    'CATÁLOGOS EXPANDIDOS: ' + quantidade,
    'green'
);


// ============================================================
// FIM
// ============================================================

uiv.log(
    'EXPANSÃO DOS CATÁLOGOS CONCLUÍDA',
    'green'
);
