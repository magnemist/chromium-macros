// ============================================================
// ROTINA DE ESPERA DO BLOQUEIO AJAX
// ============================================================

function aguardarProcessamento(etapa) {
    uiv.sleep(300);

    const inicio = Date.now();
    const limiteMs = 60000;

    while (true) {
        const bloqueioAtivo = uiv.evaluate(`
            return Array.from(
                document.querySelectorAll('div.blockUI.blockMsg')
            ).some(function(el) {
                const estilo = window.getComputedStyle(el);
                const ret = el.getBoundingClientRect();

                return estilo.display !== 'none' &&
                       estilo.visibility !== 'hidden' &&
                       Number(estilo.opacity || 1) > 0 &&
                       ret.width > 0 &&
                       ret.height > 0;
            });
        `);

        if (!bloqueioAtivo) {
            uiv.log('PROCESSAMENTO CONCLUÍDO: ' + etapa, 'green');
            return;
        }

        if (Date.now() - inicio >= limiteMs) {
            throw new Error('Tempo esgotado aguardando: ' + etapa);
        }

        uiv.sleep(500);
    }
}


