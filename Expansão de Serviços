// Expansão Serviços.js
// Central de Serviços UFV
// Fluxo: perfil 11230 → fornecedor PAD → catálogo → expansão dos catálogos

// 1. Abre a solicitação para o Campus Viçosa
uiv.goto('https://central-servicos.ufv.br/solicitacoes/criar?campus=1');

uiv.log('PÁGINA INICIAL ABERTA', 'green');

// 2. Aguarda o perfil 11230 aparecer
uiv.$(
    'xpath=//*[normalize-space(text())="11230"]'
);

uiv.log('PERFIL 11230 ENCONTRADO', 'green');

// 3. Seleciona o perfil 11230
uiv.page.click(
    'xpath=//*[normalize-space(text())="11230"]'
);

uiv.log('PERFIL 11230 SELECIONADO', 'green');

// 4. Aguarda a tela de fornecedor carregar
uiv.$(
    'xpath=//a[contains(normalize-space(.),"Ver Catálogo de Serviços")]'
);

uiv.log('CATÁLOGO ENCONTRADO', 'green');

// 5. Abre o catálogo de serviços
uiv.page.click(
    'linkText=Ver Catálogo de Serviços...'
);

uiv.log('CATÁLOGO OK', 'green');

// 6. Expande todos os catálogos
const quantidade = uiv.evaluate(`
    const paineis = document.querySelectorAll(
        '#conteudo .panel-body.collapse[id^="catalogo_"]'
    );

    paineis.forEach(painel => {
        painel.classList.add('in');
        painel.setAttribute('aria-expanded', 'true');
        painel.style.height = '';
    });

    const botoes = document.querySelectorAll(
        '#conteudo .panel-heading[data-toggle="collapse"][data-target^="#catalogo_"]'
    );

    botoes.forEach(botao => {
        botao.setAttribute('aria-expanded', 'true');
    });

    return paineis.length;
`);

uiv.log(
    `CATÁLOGOS EXPANDIDOS: ${quantidade}`,
    'green'
);
